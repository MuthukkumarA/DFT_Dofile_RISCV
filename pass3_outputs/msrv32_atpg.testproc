set time scale 1.000000 ns ;
 timeplate gen_tp1 =
    force_pi 0 ; 
    measure_po 10 ; 
    pulse_clock 20 10 ; 
    period 40 ; 
 end;

 procedure test_setup =
    timeplate gen_tp1 ;
    // cycle 0 starts at time 0
    cycle =
        force ltest_en 1 ;
        force scan_en 0 ;
    end;
 end;

 procedure shift =
    scan_group grp1 ;
    timeplate gen_tp1 ;
    // cycle 0 starts at time 0
    cycle =
        force_sci ;
        measure_sco ;
        pulse ms_riscv32_mp_clk_in ;
        pulse tck_p ;
    end;
 end;

 procedure load_unload =
    scan_group grp1 ;
    timeplate gen_tp1 ;
    // cycle 0 starts at time 0
    cycle =
        force ltest_en 1 ;
        force ms_riscv32_mp_clk_in 0 ;
        force ms_riscv32_mp_data_hready_in 0 ;
        force ms_riscv32_mp_hresp_in 1 ;
        force ms_riscv32_mp_instr_hready_in 0 ;
        force ms_riscv32_mp_instr_in[6] 1 ;
        force ms_riscv32_mp_rst_in 0 ;
        force scan_en 1 ;
        force scan_set 0 ;
        force tck_p 1 ;
        force trst_p 1 ;
    end ;
    apply shift 344;
 end;

