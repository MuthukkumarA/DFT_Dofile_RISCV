iProcsForModule msrv32_top

iTopProc msrv32_top {} {

   iForcePort [list "scan_en"] 0b0 -not_persistent
   iApply

   iReset
   iNote "Activate selection of the following scan muxes:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.DRMux, selection 9: instruction = 'bx -> DRMux = bypass"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction[3:0] 0b1011
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction[3:0] 0b0001
   iApply

   iNote "Scan in verification pattern to the following scan register:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass, load value = 1"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b1
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b0
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan register:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass, expected value = 1"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b0
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.DRMux, selection 8: instruction = 4'b0111 -> DRMux = host_1_from_so"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction[3:0] 0b0111
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction[3:0] 0b0001
   iApply

   iNote "Scan in verification pattern to the following scan register:"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib, load value = 1"
   iWrite msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib 0b1
   iRead  msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib 0b0
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan register:"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib 0b1
   iRead  msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.DRMux, selection 8: instruction = 4'b0111 -> DRMux = host_1_from_so"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_ctrl_inst.scan_in_mux, selection 0: sib = 1'b0 -> scan_in_mux = ijtag_si"
   iNote "Scan in verification pattern to the following scan registers:"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_ctrl_inst.sib, load value = 0"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib, load value = 1"
   iWrite msrv32_top_pass1_rtl_tessent_sib_sri_ctrl_inst.sib 0b0
   iRead  msrv32_top_pass1_rtl_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib 0b1
   iRead  msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib 0b0
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan registers:"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_ctrl_inst.sib, expected value = 0"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite msrv32_top_pass1_rtl_tessent_sib_sri_ctrl_inst.sib 0b1
   iRead  msrv32_top_pass1_rtl_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib 0b1
   iRead  msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.DRMux, selection 8: instruction = 4'b0111 -> DRMux = host_1_from_so"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_ctrl_inst.scan_in_mux, selection 1: sib = 1'b1 -> scan_in_mux = ijtag_from_so"
   iNote "Scan in verification pattern to the following scan registers:"
   iNote "  msrv32_top_pass1_rtl_tessent_tdr_sri_ctrl_inst.tdr\[0:0\], load value = 1"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_ctrl_inst.sib, load value = 0"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib, load value = 1"
   iWrite msrv32_top_pass1_rtl_tessent_tdr_sri_ctrl_inst.tdr[0] 0b1
   iRead  msrv32_top_pass1_rtl_tessent_tdr_sri_ctrl_inst.tdr[0] 0b0
   iWrite msrv32_top_pass1_rtl_tessent_sib_sri_ctrl_inst.sib 0b0
   iRead  msrv32_top_pass1_rtl_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib 0b1
   iRead  msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib 0b0
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan registers:"
   iNote "  msrv32_top_pass1_rtl_tessent_tdr_sri_ctrl_inst.tdr\[0:0\], expected value = 1"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_ctrl_inst.sib, expected value = 0"
   iNote "  msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib, expected value = 1"
   iWrite msrv32_top_pass1_rtl_tessent_tdr_sri_ctrl_inst.tdr[0] 0b0
   iRead  msrv32_top_pass1_rtl_tessent_tdr_sri_ctrl_inst.tdr[0] 0b1
   iWrite msrv32_top_pass1_rtl_tessent_sib_sri_ctrl_inst.sib 0b0
   iRead  msrv32_top_pass1_rtl_tessent_sib_sri_ctrl_inst.sib 0b0
   iWrite msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib 0b0
   iRead  msrv32_top_pass1_rtl_tessent_sib_sri_inst.sib 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.DRMux, selection 7: instruction = 4'b0110 -> DRMux = bypass"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction[3:0] 0b0110
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction[3:0] 0b0001
   iApply

   iNote "Scan in verification pattern to the following scan register:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass, load value = 1"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b1
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b0
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan register:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass, expected value = 1"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b0
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.DRMux, selection 1: instruction = 4'b0000 -> DRMux = bypass"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction[3:0] 0b0000
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction[3:0] 0b0001
   iApply

   iNote "Scan in verification pattern to the following scan register:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass, load value = 1"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b1
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b0
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan register:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass, expected value = 1"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b0
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b1
   iApply

   iNote "Activate selection of the following scan muxes:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.IRMux, selection 0: fsm.irSel = 1'b0 -> IRMux = DRMux"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.DRMux, selection 0: instruction = 4'b1111 -> DRMux = bypass"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction[3:0] 0b1111
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction[3:0] 0b0001
   iApply

   iNote "Scan in verification pattern to the following scan register:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass, load value = 1"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b1
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b0
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan register:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass, expected value = 1"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b0
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.bypass 0b1
   iApply

   iNote "Activate selection for scan mux msrv32_top_pass1_rtl_tessent_tap_main_inst.IRMux, selection 1: fsm.irSel = 1'b1 -> IRMux = instruction\[0\]"
   iNote "Scan in verification pattern to the following scan register:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction\[3:0\], load value = 1011"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction[3:0] 0b1011
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction[3:0] 0b0001
   iApply -end_in_pause

   iNote "Scan out verification pattern from the following scan register:"
   iNote "  msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction\[3:0\], expected value = 1011"
   iWrite msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction[3:0] 0b1111
   iRead  msrv32_top_pass1_rtl_tessent_tap_main_inst.instruction[3:0] 0b1011
   iApply


}
